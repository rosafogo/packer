autoinstall:
  version: 1
  identity:
    hostname: multiflora
    username: admin
    password: "$6$dIMP8PyLSkuJcSIR$sR2JBRwrlgjiTH4AA19gmYCSs9uD/Le6dxy3kI.QUaPfkRAjvVr9FtJAeWmwz0gfDyoeYy8m4gzjD8djSKp2f0"
  ssh:
    install-server: true
    allow-pw: true
  storage:
